    def dropdown_text(self, dropdown):
        item = dropdown.get_selected_item()
        return item.get_string()

    def connection_tick(self):
        self.refresh_connection(quiet=True)
        return True

    def refresh_connection(self, quiet=False, active=False):
        controller = BetaBriteController(port=PORT)

        if active:
            diagnostic = controller.check_connection()
            if diagnostic.ready:
                self.last_ready_port = diagnostic.port
            else:
                self.last_ready_port = None
        else:
            diagnostic = diagnose_device(PORT)

        display_diagnostic = diagnostic

        if (
            not active
            and diagnostic.state == "selected"
            and diagnostic.port == self.last_ready_port
        ):
            display_diagnostic = ConnectionDiagnostic(
                state="ready",
                message=(
                    f"Serial port {diagnostic.port} remains selected "
                    "after the last successful connection check."
                ),
                port=diagnostic.port,
                source=diagnostic.source,
            )

        if diagnostic.state in {
            "no-adapter",
            "not-found",
            "port-not-found",
        }:
            self.last_ready_port = None

        view = connection_view(display_diagnostic)

        for css_class in (
            "connection-online",
            "connection-selected",
            "connection-offline",
        ):
            self.connection.remove_css_class(css_class)

        css_class = {
            "online": "connection-online",
            "selected": "connection-selected",
            "offline": "connection-offline",
        }[view.tone]

        self.connection.set_text(view.headline)
        self.connection.add_css_class(css_class)
        self.send_button.set_sensitive(view.can_send)

        if not quiet:
            port = view.port or "no port"
            self.status.set_text(
                f"{port}  //  {view.state.upper()}  //  {view.detail}"
            )

    def on_refresh(self, *_):
        self.refresh_connection(active=True)

    def on_color(self, button, name):
        if not button.get_active():
            if self.selected_color == name:
                button.set_active(True)
            return

        self.selected_color = name

        for other_name, other_button in self.color_buttons.items():
            if other_name != name:
                other_button.set_active(False)

    def on_speed(self, button, level):
        if not button.get_active():
            if self.selected_speed == level:
                button.set_active(True)
            return

        self.selected_speed = level

        for other_level, other_button in self.speed_buttons.items():
            if other_level != level:
                other_button.set_active(False)

    def on_preset(self, button, text):
        self.message.set_text(text)
        self.message.grab_focus()
        self.message.set_position(-1)

    def on_hardware_setup(self, *_):
        if (
            self.hardware_window is None
            or not self.hardware_window.get_visible()
        ):
            self.hardware_window = HardwareSetupWindow(self)

        self.hardware_window.present()

    def on_about(self, *_):
        if (
            self.about_window is None
            or not self.about_window.get_visible()
        ):
            self.about_window = AboutWindow(self)

        self.about_window.present()

    def on_send(self, *args):
        message = self.message.get_text().strip()

        if not message:
            self.status.set_text(
                "Enter a message before sending."
            )
            return

        self.refresh_connection(quiet=True)

        if not self.send_button.get_sensitive():
            self.status.set_text(
                "Connection is not ready — open Hardware Setup or press Refresh."
            )
            return

        selected_mode = self.dropdown_text(
            self.mode
        )
        selected_special = self.dropdown_text(
            self.special
        )

        self.send_button.set_sensitive(False)
        self.status.set_text("TRANSMITTING...")

        try:
            controller = BetaBriteController(
                port=PORT
            )

            controller.send(
                message=message,
                color_name=COLORS[self.selected_color],
                mode_name=MODES[selected_mode],
                special_name=SPECIALS[selected_special],
                speed_level=self.selected_speed,
                flash=self.flash.get_active(),
                wide=self.wide.get_active(),
            )

            self.last_ready_port = controller.last_port
            self.status.set_text(
                f'TRANSMITTED  //  "{message}"'
            )

        except BetaBriteTransportError as exc:
            self.last_ready_port = None
            label = exc.state.replace("-", " ").upper()
            self.status.set_text(
                f"{label}  //  {exc}"
            )

        except Exception as exc:
            self.last_ready_port = None
            self.status.set_text(
                f"TRANSMIT FAILED  //  {exc}"
            )

        finally:
            self.refresh_connection(quiet=True)


class BetaBriteApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="dev.grubbs.BetaBriteController"
        )

    def do_startup(self):
        Gtk.Application.do_startup(self)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())

        display = Gdk.Display.get_default()
        Gtk.StyleContext.add_provider_for_display(
            display,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def do_activate(self):
        window = self.props.active_window

        if window is None:
            window = BetaBriteWindow(self)

        window.present()


app = BetaBriteApp()
app.run()
