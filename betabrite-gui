            "SIGN     Adaptive Micro Systems BetaBrite 213C-1 // Series B",
            "ADAPTER  DSD TECH SH-RJ12C // Prolific PL2303GT",
            "SERIAL   9600 baud // 7 data bits // even parity // 1 stop bit",
        ):
            row = Gtk.Label(label=text)
            row.set_xalign(0)
            row.set_selectable(True)
            info.append(row)

        self.device_row = Gtk.Label(label="DEVICE   discovering...")
        self.device_row.set_xalign(0)
        self.device_row.set_selectable(True)
        info.append(self.device_row)

        outer.append(info)

        outer.append(section_label("SERIAL ADAPTER"))

        self.device_ports = []
        self.device_dropdown = Gtk.DropDown.new_from_strings(
            ["Searching for USB serial adapters..."]
        )
        outer.append(self.device_dropdown)

        device_actions = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=10,
        )

        remember = Gtk.Button(label="USE SELECTED ADAPTER")
        remember.set_hexpand(True)
        remember.connect("clicked", self.on_remember)

        forget = Gtk.Button(label="FORGET SAVED ADAPTER")
        forget.set_hexpand(True)
        forget.connect("clicked", self.on_forget)

        device_actions.append(remember)
        device_actions.append(forget)
        outer.append(device_actions)

        outer.append(section_label("RJ12 WIRING"))

        wiring_help = Gtk.Label(
            label=(
                "Wire the BetaBrite-side RJ12 connector exactly as shown "
                "for the tested DSD TECH adapter."
            )
        )
        wiring_help.set_xalign(0)
        wiring_help.set_wrap(True)
        outer.append(wiring_help)

        wiring = Gtk.Grid(
            column_spacing=18,
            row_spacing=10,
        )
        wiring.set_column_homogeneous(False)
        wiring.add_css_class("hardware-card")

        headers = ("PIN", "WIRE", "FUNCTION")
        for column, text in enumerate(headers):
            label = Gtk.Label(label=text)
            label.set_xalign(0)
            label.add_css_class("section-title")
            wiring.attach(label, column, 0, 1, 1)

        rows = (
            ("1", "YELLOW", "GND"),
            ("2", "EMPTY", "—"),
