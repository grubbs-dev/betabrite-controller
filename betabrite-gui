    def populate_devices(self):
        devices = list_candidate_devices()
        self.device_ports = [device.device for device in devices]

        if not devices:
            labels = ["No USB serial adapters detected"]
        else:
            labels = [
                (
                    f"{device.device}  //  {device.display_name}"
                    + (f"  [{device.usb_id}]" if device.usb_id else "")
                    + ("  // TESTED" if device.preferred else "")
                )
                for device in devices
            ]

        self.device_dropdown.set_model(Gtk.StringList.new(labels))
        self.device_dropdown.set_selected(0)

    def selected_device_port(self):
        index = self.device_dropdown.get_selected()
        if index < 0 or index >= len(self.device_ports):
            return None
        return self.device_ports[index]

    def refresh_device(self):
        self.populate_devices()
        controller = BetaBriteController(port=PORT)
        diagnostic = controller.check_connection()
        view = connection_view(diagnostic)

        port_text = view.port or "none"
        self.device_row.set_text(f"DEVICE   {port_text}")
        self.device_status.set_text(
            f"{view.headline}   {view.detail}"
        )
        self.test_button.set_sensitive(view.can_send)

    def on_refresh(self, *_):
        self.refresh_device()
        self.parent_window.refresh_connection(active=True)

    def on_remember(self, *_):
        port = self.selected_device_port()
        if port is None:
            self.device_status.set_text(
                "No USB serial adapter is available to remember."
            )
            return

        try:
            selection = remember_port(port)
            self.device_status.set_text(
                f"Saved {selection.port} as the preferred BetaBrite adapter."
            )
            self.parent_window.status.set_text(
                f"Saved adapter // {selection.port}"
            )
        except Exception as exc:
            self.device_status.set_text(
                f"Could not save adapter: {exc}"
            )
            return

        self.refresh_device()
        self.parent_window.refresh_connection(active=True)

    def on_forget(self, *_):
        forget_port()
        self.device_status.set_text(
            "Forgot the saved BetaBrite serial adapter."
        )
        self.parent_window.status.set_text(
            "Saved adapter cleared."
        )
        self.refresh_device()
        self.parent_window.refresh_connection(active=True)

    def on_test(self, *_):
        controller = BetaBriteController(port=PORT)
        diagnostic = controller.check_connection()
        view = connection_view(diagnostic)

        if not view.can_send:
            self.device_status.set_text(
                f"{view.headline}   {view.detail}"
            )
            self.test_button.set_sensitive(False)
            return

        self.test_button.set_sensitive(False)
        self.device_status.set_text("Transmitting hardware test...")

        try:
            controller.send(
                message="BETABRITE // READY",
                color_name="green",
                mode_name="hold",
                speed_level=3,
            )

            self.parent_window.last_ready_port = controller.last_port
            self.device_status.set_text(
                'Test transmitted — sent "BETABRITE // READY"'
            )
            self.parent_window.status.set_text(
                "Hardware test transmitted successfully."
            )

        except BetaBriteTransportError as exc:
            label = exc.state.replace("-", " ").upper()
            self.parent_window.last_ready_port = None
            self.device_status.set_text(f"{label}: {exc}")
            self.parent_window.status.set_text(f"{label} // {exc}")

        except Exception as exc:
            self.parent_window.last_ready_port = None
            self.device_status.set_text(
                f"Hardware test failed: {exc}"
            )
            self.parent_window.status.set_text(
                f"Hardware test failed: {exc}"
            )

        finally:
            self.test_button.set_sensitive(True)
            self.parent_window.refresh_connection(quiet=True)


